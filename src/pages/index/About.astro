---
const interests = ["Website development", "System creation", "Technology"];
---

<section class="about" id="about">
  <h2>About Me</h2>
  <p>
    I am an Information Systems student passionate about website development,
    system creation, and technology.
  </p>
  <p>Here, I share my background, interests, and projects.</p>

  <ul class="interests">
    {interests.map((item) => <li>{item}</li>)}
  </ul>
</section>

<style>
  .about { max-width: 860px; margin: 0 auto; padding: 80px 20px; }
  h2 { margin: 0 0 20px; font-size: 2rem; color: var(--name); }
  p { margin: 0 0 14px; max-width: 62ch; line-height: 1.8; }
  .interests { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 24px 0 0; }
  .interests li {
    padding: 8px 16px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--name-accent);
  }
</style>