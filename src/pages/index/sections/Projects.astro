---
// Replace these placeholders with your real projects.
const projects = [
  { title: "Project One", description: "Short description of what it does and what you built.", tech: ["Astro", "Tailwind"], link: "#" },
  { title: "Project Two", description: "Short description of what it does and what you built.", tech: ["JavaScript", "CSS"], link: "#" },
  { title: "Project Three", description: "Short description of what it does and what you built.", tech: ["Information Systems"], link: "#" },
];
---

<section class="projects" id="work">
  <h2>My Projects</h2>

  <div class="grid">
    {projects.map((p) => (
      <article class="project">
        <h3>{p.title}</h3>
        <p>{p.description}</p>
        <ul>{p.tech.map((t) => <li>{t}</li>)}</ul>
        <a href={p.link}>View project ↗</a>
      </article>
    ))}
  </div>
</section>

<style>
  .projects { max-width: 1000px; margin: 0 auto; padding: 80px 20px; }
  h2 { margin: 0 0 28px; font-size: 2rem; color: var(--name); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .project {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: color-mix(in srgb, var(--text) 5%, transparent);
  }
  h3 { margin: 0 0 10px; color: var(--name); font-size: 1.15rem; }
  p { margin: 0 0 16px; line-height: 1.7; flex: 1; }
  ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0 0 18px; }
  li { font-size: 0.78rem; color: var(--name-accent); border: 1px solid var(--rule); border-radius: 999px; padding: 4px 10px; }
  a { color: var(--name-accent); text-decoration: none; font-weight: 600; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid var(--name-accent); outline-offset: 3px; }
</style>