---
const email = "your-email@example.com"; // change this to your real email

// Create a free form at formspree.io and paste your form ID here.
const formAction = "https://formspree.io/f/your-form-id";

// name = platform, detail = text shown under the name, href = where it links.
// Edit these to match your real profiles.
const socials = [
  { name: "Email", detail: "kudoflynx@gmail.com", href: `mailto:${email}`, external: true },
  { name: "GitHub", detail: "@loraez-chafio", href: "https://github.com/loraez-chafio", external: true },
  { name: "Reddit", detail: "chafioriazia", href: "https://www.reddit.com/user/loraez-chafio", external: true },
  { name: "Discord", detail: "flynxgod", href: "https://discord.com/users/YOUR_DISCORD_USER_ID", external: true },
  { name: "Facebook", detail: "Ralph Damiel Loraez", href: "https://www.facebook.com/loraez-chafio", external: true },
  { name: "Instagram", detail: "chafioria_queza", href: "https://www.instagram.com/loraez-chafio", external: true },
];
---

<section class="contact" id="contact">
  <h2>Contact</h2>
  <p>Want to work together or just say hi? Send me a message.</p>
  <p class="handle">@loraez-chafio</p>

  <form class="form" action={formAction} method="POST">
    <label class="field">
      <span>Name</span>
      <input type="text" name="name" placeholder="Your name" required />
    </label>

    <label class="field">
      <span>Email</span>
      <input type="email" name="email" placeholder="kudoflynx@gmail.com" required />
    </label>

    <label class="field">
      <span>Message</span>
      <textarea name="message" rows="6" placeholder="Write your message..." required></textarea>
    </label>

    <button type="submit" class="cta">Send message</button>
  </form>

  <div class="socials">
    <p class="socials-label">Or reach me on</p>
    <div class="socials-list">
      {socials.map((s) => (
        <a
          class="social"
          href={s.href}
          target={s.external ? "_blank" : undefined}
          rel={s.external ? "noopener noreferrer" : undefined}
        >
          <span class="social-name">{s.name}</span>
          <span class="social-detail">{s.detail}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact { max-width: 860px; margin: 0 auto; padding: 80px 20px 100px; text-align: center; }
  h2 { margin: 0 0 16px; font-size: 2rem; color: var(--name); }
  p { margin: 0 auto 12px; max-width: 52ch; line-height: 1.8; }
  .handle { color: var(--name-accent); font-size: 1.1rem; margin-bottom: 26px; }

  .form {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
    text-align: left;
  }

  .field { display: flex; flex-direction: column; gap: 6px; font-size: 0.9rem; font-weight: 600; }

  .field input,
  .field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    font: inherit;
    font-weight: 400;
    color: inherit;
    background: transparent;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    border-radius: 8px;
    transition: border-color 0.2s;
  }

  .field textarea { resize: vertical; }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--name-accent);
    outline-offset: 2px;
    border-color: var(--name-accent);
  }

  .cta {
    display: inline-block;
    align-self: flex-start;
    background: var(--btn-bg);
    color: var(--btn-text);
    text-decoration: none;
    padding: 13px 24px;
    border: none;
    border-radius: 8px;
    font: inherit;
    cursor: pointer;
    transition: filter 0.2s, transform 0.2s;
  }
  .cta:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .cta:focus-visible { outline: 2px solid var(--name-accent); outline-offset: 3px; }

  .socials { margin-top: 48px; }
  .socials-label { margin-bottom: 16px; opacity: 0.75; }
  .socials-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

  .social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 150px;
    background: var(--btn-bg);
    color: var(--btn-text);
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 8px;
    transition: filter 0.2s, transform 0.2s;
  }
  .social:hover { filter: brightness(1.12); transform: translateY(-1px); }
  .social:focus-visible { outline: 2px solid var(--name-accent); outline-offset: 3px; }

  .social-name { font-weight: 600; }
  .social-detail { font-size: 0.8rem; opacity: 0.8; overflow-wrap: anywhere; }
</style>