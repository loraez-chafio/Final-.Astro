---
import "../styles/global.css";
import CircuitBackground from "../components/CircuitBackground.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const name = "Ralph Damiel Loraez";
---

<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{name}</title>

  <!-- applies the saved theme before first paint, so it must stay inline -->
  <script is:inline>
    try {
      if (localStorage.getItem("theme") === "light") {
        document.documentElement.classList.remove("dark");
      }
    } catch {}
  </script>

  <style is:global>
    /* ---------- colors ---------- */
    :root {
      --bg: #f1e6d6;
      --text: #3a2a1e;
      --name: #3a2a1e;
      --name-accent: #a8622a;
      --rule: #b9966f;
      --line: rgba(120, 80, 45, 0.22);
      --btn-bg: #8a5a3c;
      --btn-text: #fbf1e3;
    }
    :root.dark {
      --bg: #2a211a;
      --text: #e8d5bf;
      --name: #e8d5bf;
      --name-accent: #c9a77f;
      --rule: #8f7a64;
      --line: rgba(201, 167, 127, 0.18);
      --btn-bg: #6e4e3a;
      --btn-text: #f6ead9;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: "Segoe UI", system-ui, sans-serif;
      transition: background 0.4s, color 0.4s;
    }

    .site-header,
    main,
    .site-footer {
      position: relative;
      z-index: 1;
    }

    /* ---------- circuit lines draw in on load / replay ---------- */
    @keyframes draw {
      to { stroke-dashoffset: 0; }
    }
    @keyframes appear {
      from { opacity: 0; }
    }

    body.play .circuit .lines path {
      stroke-dashoffset: 1;
      animation: draw 2.4s ease-out forwards;
    }
    body.play .circuit .nodes circle,
    body.play .circuit .tiles > * {
      animation: appear 1s ease-out 0.8s both;
    }

    @media (prefers-reduced-motion: reduce) {
      body.play .circuit .lines path,
      body.play .circuit .nodes circle,
      body.play .circuit .tiles > * {
        animation: none;
        stroke-dashoffset: 0;
      }
    }

    /* ---------- GSAP helpers ---------- */
    /* stops CSS hover transitions from fighting GSAP while it moves an element */
    .gsap-busy {
      transition: none !important;
    }

    /* thin bar at the top that fills as you scroll (driven by GSAP) */
    #scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--name-accent);
      transform: scaleX(0);
      transform-origin: 0 50%;
      z-index: 50;
      pointer-events: none;
    }
  </style>
</head>

<body class="play">
  <div id="scroll-progress"></div>

  <CircuitBackground />
  <Header name={name} />

  <main>
    <slot />
  </main>

  <Footer name={name} />

  <!-- GSAP + ScrollTrigger (same CDN you used in your HTML version) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/ScrollTrigger.min.js"></script>

  <script is:inline>
    (function () {
      const hasGsap = !!(window.gsap && window.ScrollTrigger);
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const canAnimate = hasGsap && !reduce;

      if (!hasGsap) {
        console.warn("GSAP did not load. The page will still display, without fades.");
      }

      // ---------- header intro (plays on load and on Replay) ----------
      let introTl;
      function introHeader() {
        if (!canAnimate) return;
        if (introTl) introTl.kill();

        const targets = gsap.utils.toArray(".brand, .site-header .btn");
        gsap.set(targets, { clearProps: "all" });
        targets.forEach((t) => t.classList.add("gsap-busy"));

        introTl = gsap
          .timeline({
            defaults: { ease: "power2.out", duration: 0.5 },
            onComplete: () => {
              gsap.set(targets, { clearProps: "all" });
              targets.forEach((t) => t.classList.remove("gsap-busy"));
            },
          })
          .from(".brand", { y: -15, autoAlpha: 0 })
          .from(".site-header .btn", { y: -10, autoAlpha: 0, stagger: 0.1 }, "-=0.25");
      }

      // ---------- scroll: scrub + fade in AND out, every time ----------
      function setupScroll() {
        gsap.registerPlugin(ScrollTrigger);

        // progress bar fills as you scroll
        gsap.to("#scroll-progress", {
          scaleX: 1,
          ease: "none",
          scrollTrigger: {
            trigger: document.documentElement,
            start: "top top",
            end: "bottom bottom",
            scrub: true,
          },
        });

        // circuit background drifts slowly
        gsap.to(".circuit", {
          y: -90,
          ease: "none",
          scrollTrigger: {
            trigger: document.documentElement,
            start: "top top",
            end: "bottom bottom",
            scrub: true,
          },
        });

        // hero fades and lifts away as you scroll past it (and back when you return)
        gsap.to("#top", {
          autoAlpha: 0,
          y: -50,
          ease: "none",
          scrollTrigger: {
            trigger: "#top",
            start: "top top",
            end: "bottom 25%",
            scrub: true,
          },
        });

        // every text block and card fades in when it arrives and out when it leaves
        const items = gsap.utils.toArray(
          "#about > *, #work h2, #work .project, #contact > *"
        );

        items.forEach((el) => {
          // links/buttons only fade, so their hover lift keeps working
          const dist = el.matches("a, button") ? 0 : 40;
          const move = (v) => (dist ? { y: v } : {});

          gsap.set(el, { autoAlpha: 0, ...move(dist) });

          const show = () =>
            gsap.to(el, {
              autoAlpha: 1,
              ...move(0),
              duration: 0.6,
              ease: "power2.out",
              overwrite: "auto",
            });

          const hide = (dir) =>
            gsap.to(el, {
              autoAlpha: 0,
              ...move(dist * dir),
              duration: 0.4,
              ease: "power2.in",
              overwrite: "auto",
            });

          ScrollTrigger.create({
            trigger: el,
            start: "top 88%",
            end: "bottom 12%",
            onEnter: show,
            onLeave: () => hide(-1),
            onEnterBack: show,
            onLeaveBack: () => hide(1),
          });
        });
      }

      if (canAnimate) {
        setupScroll();
        introHeader();
      }

      // ---------- Toggle Theme (remembers the choice, button spins) ----------
      const themeBtn = document.getElementById("darkModeToggle");
      themeBtn?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch {}

        if (canAnimate && themeBtn) {
          themeBtn.classList.add("gsap-busy");
          gsap.fromTo(
            themeBtn,
            { rotation: 0 },
            {
              rotation: 360,
              duration: 0.5,
              ease: "power2.inOut",
              onComplete: () => {
                gsap.set(themeBtn, { clearProps: "all" });
                themeBtn.classList.remove("gsap-busy");
              },
            }
          );
        }
      });

      // ---------- Replay Animation ----------
      document.getElementById("replayAnimation")?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
        document.body.classList.remove("play");
        void document.body.offsetWidth; // force a reflow so the CSS animations restart
        document.body.classList.add("play");
        introHeader();
        window.dispatchEvent(new CustomEvent("replay-animation"));
      });
    })();
  </script>
</body>
</html>